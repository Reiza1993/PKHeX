<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PKHeX.Avalonia.MainWindow"
        Title="PKHeX (Avalonia)"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Button.slot">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.slot.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox, TextBox, NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="Menu_Open" />
        <MenuItem x:Name="MenuSave" Header="_Save" InputGesture="Ctrl+S" Click="Menu_Save" IsEnabled="False" />
        <MenuItem x:Name="MenuSaveAs" Header="Save _As…" InputGesture="Ctrl+Shift+S" Click="Menu_SaveAs" IsEnabled="False" />
        <Separator />
        <MenuItem Header="E_xit" Click="Menu_Exit" />
      </MenuItem>
      <MenuItem Header="_Pokémon">
        <MenuItem Header="_Import from file…" Click="Menu_ImportPKM" />
        <MenuItem Header="_Export to file…" Click="Menu_ExportPKM" />
        <Separator />
        <MenuItem Header="Import _Showdown set…" Click="Menu_ShowdownImport" />
        <MenuItem Header="Export S_howdown set…" Click="Menu_ShowdownExport" />
        <Separator />
        <MenuItem Header="Evolve by _trade" Click="Menu_TradeEvolve" />
        <Separator />
        <MenuItem Header="Check _legality" InputGesture="Ctrl+L" Click="Menu_Legality" />
      </MenuItem>
      <MenuItem x:Name="MenuTools" Header="_Tools" IsEnabled="False">
        <MenuItem x:Name="MenuTrainer" Header="_Trainer…" Click="Menu_Trainer" />
        <MenuItem x:Name="MenuBag" Header="_Bag / Items…" Click="Menu_Bag" />
        <MenuItem x:Name="MenuDex" Header="_Pokédex…" Click="Menu_Pokedex" />
        <MenuItem x:Name="MenuEvents" Header="_Event flags…" Click="Menu_EventFlags" />
        <Separator />
        <MenuItem Header="Batch _editor…" Click="Menu_Batch" />
        <MenuItem Header="Transfer _missing Pokémon from another save…" Click="Menu_Transfer" />
        <MenuItem x:Name="MenuGen3" IsVisible="False" Header="_Gen 3 tools (FireRed/LeafGreen, Ruby/Sapphire/Emerald)…" Click="Menu_Gen3" />
        <Separator />
        <MenuItem x:Name="MenuBoxes" Header="Bo_xes">
          <MenuItem Header="Arrange by Pokédex number (living dex, gaps for missing)" Click="Menu_LivingDex" />
          <MenuItem Header="Sort all boxes by species" Click="Menu_SortBoxes" />
          <MenuItem Header="Clear current box" Click="Menu_ClearBox" />
          <MenuItem Header="Export all boxes to folder…" Click="Menu_DumpBoxes" />
          <MenuItem Header="Export current box as Showdown text…" Click="Menu_ShowdownBox" />
          <MenuItem Header="Legality report for all boxes…" Click="Menu_LegalityReport" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _updates…" Click="Menu_Update" />
        <Separator />
        <MenuItem Header="_About" Click="Menu_About" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock x:Name="StatusText" Text="Open a save file (File → Open, or drag and drop it onto this window)." />
    </Border>

    <Grid ColumnDefinitions="Auto,*" Margin="8">
      <!-- Save file: info, boxes and party -->
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <Border DockPanel.Dock="Top" Padding="8" CornerRadius="4" Margin="0,0,0,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="2">
            <TextBlock x:Name="SaveTitle" FontWeight="Bold" FontSize="16" Text="No save file loaded" />
            <TextBlock x:Name="SaveDetails" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TabControl x:Name="StorageTabs">
          <TabItem Header="Box">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                <Button Grid.Column="0" Content="◀" Click="Box_Prev" />
                <ComboBox Grid.Column="1" x:Name="BoxSelector" Margin="6,0" SelectionChanged="Box_Changed" />
                <Button Grid.Column="2" Content="▶" Click="Box_Next" />
              </Grid>
              <Button DockPanel.Dock="Bottom" x:Name="BtnLivingDex" Content="Arrange boxes by Pokédex number" Click="Menu_LivingDex"
                      HorizontalAlignment="Left" Margin="2,8,0,0" IsEnabled="False" />
              <WrapPanel x:Name="BoxGrid" Width="480" />
            </DockPanel>
          </TabItem>
          <TabItem Header="Party">
            <WrapPanel x:Name="PartyGrid" Width="480" />
          </TabItem>
        </TabControl>
      </DockPanel>

      <!-- Pokémon editor -->
      <DockPanel Grid.Column="1">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button x:Name="BtnApply" Content="Save to selected slot" Click="Slot_Apply" IsEnabled="False" />
          <Button x:Name="BtnDelete" Content="Delete slot" Click="Slot_Delete" IsEnabled="False" />
          <Button Content="Check legality" Click="Menu_Legality" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Padding="8" CornerRadius="4" Margin="0,0,0,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Image Grid.Column="0" x:Name="PreviewSprite" Width="68" Height="56" Margin="0,0,8,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="PreviewTitle" FontWeight="Bold" FontSize="16" />
              <TextBlock x:Name="LegalityText" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="BtnEvolve" Content="Evolve" IsVisible="False" Click="Menu_TradeEvolve"
                    VerticalAlignment="Center" Margin="0,0,12,0" />
            <Image Grid.Column="3" x:Name="BallSprite" Width="32" Height="32" />
          </Grid>
        </Border>

        <TabControl x:Name="EditorTabs">
          <TabItem Header="Main">
            <ScrollViewer>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                <TextBlock Classes="label" Grid.Row="0" Text="Species" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CB_Species" SelectionChanged="Species_Changed" />
                <TextBlock Classes="label" Grid.Row="1" Text="Form" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CB_Form" />
                <TextBlock Classes="label" Grid.Row="2" Text="Nickname" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                  <TextBox x:Name="TB_Nickname" />
                  <CheckBox Grid.Column="1" x:Name="CHK_Nicknamed" Content="Nicknamed" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Classes="label" Grid.Row="3" Text="Level" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NUD_Level" Minimum="1" Maximum="100" FormatString="0" Increment="1" />
                <TextBlock Classes="label" Grid.Row="4" Text="Nature" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CB_Nature" />
                <TextBlock Classes="label" Grid.Row="5" Text="Ability" />
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CB_Ability" />
                <TextBlock Classes="label" Grid.Row="6" Text="Held Item" />
                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="CB_HeldItem" />
                <TextBlock Classes="label" Grid.Row="7" Text="Ball" />
                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="CB_Ball" />
                <TextBlock Classes="label" Grid.Row="8" Text="Language" />
                <ComboBox Grid.Row="8" Grid.Column="1" x:Name="CB_Language" />
                <TextBlock Classes="label" Grid.Row="9" Text="Gender" />
                <ComboBox Grid.Row="9" Grid.Column="1" x:Name="CB_Gender" />
                <TextBlock Classes="label" Grid.Row="10" Text="Flags" />
                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                  <CheckBox x:Name="CHK_Shiny" Content="Shiny" />
                  <CheckBox x:Name="CHK_Egg" Content="Is Egg" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Moves">
            <ScrollViewer>
              <StackPanel Margin="4" Spacing="4">
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Text="Current moves" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="PP Ups" FontWeight="Bold" Margin="8,0,0,0" />
                  <ComboBox Grid.Row="1" x:Name="CB_Move1" />
                  <ComboBox Grid.Row="2" x:Name="CB_Move2" />
                  <ComboBox Grid.Row="3" x:Name="CB_Move3" />
                  <ComboBox Grid.Row="4" x:Name="CB_Move4" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NUD_PPUp1" Minimum="0" Maximum="3" FormatString="0" Margin="8,2,0,2" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="NUD_PPUp2" Minimum="0" Maximum="3" FormatString="0" Margin="8,2,0,2" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NUD_PPUp3" Minimum="0" Maximum="3" FormatString="0" Margin="8,2,0,2" />
                  <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="NUD_PPUp4" Minimum="0" Maximum="3" FormatString="0" Margin="8,2,0,2" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Suggest legal moves" Click="Moves_Suggest" />
                  <Button Content="Random legal moves" Click="Moves_Random" />
                </StackPanel>
                <StackPanel x:Name="RelearnPanel" Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="Relearn moves" FontWeight="Bold" />
                  <ComboBox x:Name="CB_Relearn1" />
                  <ComboBox x:Name="CB_Relearn2" />
                  <ComboBox x:Name="CB_Relearn3" />
                  <ComboBox x:Name="CB_Relearn4" />
                  <Button Content="Suggest relearn moves" Click="Moves_SuggestRelearn" />
                </StackPanel>
                <TextBlock Text="PP is refilled when the moves or PP Ups are changed." Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Stats">
            <ScrollViewer>
              <StackPanel Margin="4" Spacing="4">
                <Grid x:Name="StatGrid" ColumnDefinitions="Auto,120,120,*" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                  <Button Content="Max IVs" Click="Stats_MaxIVs" />
                  <Button Content="Clear EVs" Click="Stats_ClearEVs" />
                </StackPanel>
                <TextBlock x:Name="L_StatTotals" Opacity="0.7" />
                <StackPanel x:Name="HyperPanel" Margin="0,8,0,0">
                  <TextBlock Text="Hyper Training" FontWeight="Bold" />
                  <WrapPanel x:Name="HyperChecks" />
                </StackPanel>
                <Grid x:Name="ExtraStatsGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                  <TextBlock Classes="label" Grid.Row="0" x:Name="L_StatNature" Text="Stat nature (mint)" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CB_StatNature" />
                  <TextBlock Classes="label" Grid.Row="1" x:Name="L_TeraOriginal" Text="Tera type" />
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CB_TeraOriginal" />
                  <TextBlock Classes="label" Grid.Row="2" x:Name="L_TeraOverride" Text="Tera type (changed)" />
                  <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CB_TeraOverride" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Trainer">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="4">
              <TextBlock Classes="label" Grid.Row="0" Text="Original Trainer" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="TB_OT" />
              <TextBlock Classes="label" Grid.Row="1" Text="TID" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NUD_TID" Minimum="0" Maximum="4294967295" FormatString="0" />
              <TextBlock Classes="label" Grid.Row="2" Text="SID" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="NUD_SID" Minimum="0" Maximum="4294967295" FormatString="0" />
            </Grid>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
